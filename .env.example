# Trade Companion 1.0.0-rc2 configuration reference.
# Copy this file to .env. Never commit .env or real tokens.
# Values below are safe defaults; optional integrations remain disabled.

# Application and structured logging
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
LOG_DIRECTORY=logs
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5
LOG_JSON_ENABLED=true
# Local backup retention
BACKUP_DIRECTORY=backups
BACKUP_DAILY_RETENTION=7
BACKUP_WEEKLY_RETENTION=4
# SQLite and trading safety. LIVE and order submission must remain false.
DATABASE_URL=sqlite:///./data/quantpilot.db
TRADING_MODE=INTERNAL_PAPER
ENABLE_MOOMOO_PAPER=false
ENABLE_INTERNAL_PAPER=true
# Optional local OpenD connectivity (disabled by default)
MOOMOO_ENABLED=false
MOOMOO_OPEND_HOST=127.0.0.1
MOOMOO_OPEND_PORT=11111
MOOMOO_CONNECTION_TIMEOUT_SECONDS=10
MOOMOO_QUOTE_ENABLED=true
MOOMOO_PAPER_ACCOUNT_DISCOVERY=true
MOOMOO_LIVE_TRADING_ENABLED=false
MOOMOO_ALLOW_ORDER_SUBMISSION=false
MOOMOO_SECURITY_FIRM=
MOOMOO_PREFERRED_MARKET=US
# Historical data request limits
HISTORY_DAILY_YEARS=5
HISTORY_60M_YEARS=2
HISTORY_15M_DAYS=365
HISTORY_5M_DAYS=180
HISTORY_1M_DAYS=60
HISTORY_ADJUSTMENT_TYPE=FORWARD
MOOMOO_HISTORY_MAX_RETRIES=3
MOOMOO_HISTORY_RETRY_DELAY_SECONDS=2
MOOMOO_HISTORY_REQUEST_INTERVAL_SECONDS=0.3
MOOMOO_HISTORY_MAX_PAGES=500
# Realtime data collection limits; runtime itself remains disabled below.
REALTIME_SYMBOLS=US.SOXL,US.MULL,US.TQQQ,US.NVDL,US.RAM,US.QQQ,US.SPY,US.SMH,US.SOXX,US.NVDA,US.AMD,US.MU
REALTIME_BATCH_SIZE=200
REALTIME_FLUSH_INTERVAL_SECONDS=1
REALTIME_QUEUE_MAX_SIZE=10000
REALTIME_STALE_SECONDS_REGULAR=30
REALTIME_STALE_SECONDS_EXTENDED=120
REALTIME_RECONNECT_MAX_ATTEMPTS=5
REALTIME_RECONNECT_DELAY_SECONDS=5
REALTIME_HEALTH_CHECK_INTERVAL_SECONDS=10
REALTIME_TICKER_RETENTION_DAYS=30
REALTIME_QUOTE_RETENTION_DAYS=90
REALTIME_BAR_RETENTION_DAYS=365
# Feature and strategy bounded processing
FEATURE_READ_CHUNK_SIZE=10000
FEATURE_WRITE_BATCH_SIZE=1000
FEATURE_MAX_WORKERS=1
MOOMOO_STRATEGY_AUTO_CALCULATE_FEATURES=true
MOOMOO_WARN_FREE_DISK_GB=15
MOOMOO_MIN_FREE_DISK_GB=10
STRATEGY_READ_CHUNK_SIZE=5000
STRATEGY_MAX_ESTIMATED_BARS=100000
# Opportunity runtime and protected Dashboard
REALTIME_RUNTIME_ENABLED=false
REALTIME_TIMEFRAMES=1m
OPPORTUNITY_MIN_SCORE=70
OPPORTUNITY_DEFAULT_EXPIRY_BARS=3
RUNTIME_POLL_INTERVAL_SECONDS=2
DASHBOARD_ADMIN_TOKEN=
DASHBOARD_READONLY_PUBLIC=false

# Sprint 09 Market Regime / Candidate Pool
MARKET_REGIME_ENABLED=true
MARKET_REGIME_TIMEFRAME=1d
MARKET_REGIME_BENCHMARK=QQQ
MARKET_REGIME_SECTOR_BENCHMARK=SOXX
MARKET_REGIME_RISK_SYMBOL=SOXS
MARKET_REGIME_MIN_BARS=120
MARKET_REGIME_CACHE_MINUTES=30
CANDIDATE_POOL_ENABLED=true
CANDIDATE_POOL_MAX_TOTAL=200
CANDIDATE_POOL_MAX_LONG=120
CANDIDATE_POOL_MAX_SHORT=120
CANDIDATE_POOL_MIN_SCORE=60
CANDIDATE_POOL_BOTH_SCORE_GAP=5
CANDIDATE_POOL_EXPIRY_HOURS=36
CANDIDATE_POOL_DAILY_ENABLED=false
CANDIDATE_POOL_DAILY_TIME=08:00
CANDIDATE_POOL_TIMEZONE=America/New_York
CANDIDATE_POOL_CONFIG_UNIVERSE_FILE=config/candidate_universe.yaml

# Sprint 10 Opportunity Review Engine
OPPORTUNITY_REVIEW_ENABLED=true
OPPORTUNITY_REVIEW_WINDOWS_FILE=config/review_windows_v1.yaml
OPPORTUNITY_REVIEW_BATCH_SIZE=100
OPPORTUNITY_REVIEW_POLL_SECONDS=300

# Sprint 11 AI Review Analyst（默认关闭；真实Key只写本机.env）
AI_REVIEW_ENABLED=false
AI_REVIEW_PROVIDER=mock
AI_REVIEW_BASE_URL=
AI_REVIEW_API_KEY=
AI_REVIEW_MODEL=
AI_REVIEW_TIMEOUT_SECONDS=60
AI_REVIEW_MAX_RETRIES=2
AI_REVIEW_BATCH_SIZE=20
AI_REVIEW_MIN_WINDOW=1D
AI_REVIEW_PROMPT_VERSION=v1
AI_REVIEW_STORE_RAW_RESPONSE=true
AI_REVIEW_AUTO_RUN=false
AI_REVIEW_ADMIN_ONLY=true

# AI Companion defaults to a deterministic offline Mock Provider.
AI_COMPANION_ENABLED=false
AI_COMPANION_PROVIDER=mock
AI_COMPANION_MODEL=mock-companion-v1
AI_COMPANION_API_KEY=
AI_COMPANION_TIMEOUT_SECONDS=30
AI_COMPANION_MAX_RETRIES=1
AI_COMPANION_MAX_OUTPUT_TOKENS=2048
AI_COMPANION_DEFAULT_LANGUAGE=zh-CN

# Optional Telegram integration. Keep disabled until deployment validation.
# TELEGRAM_BOT_TOKEN, CHAT IDs and administrator IDs are secrets/local identifiers.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHAT_IDS=
TELEGRAM_ADMIN_IDS=
TELEGRAM_ADMIN_USERNAMES=
TELEGRAM_TIMEOUT_SECONDS=10
TELEGRAM_MAX_RETRIES=2
# Telegram Bot profile aliases. Secrets remain local; every profile is disabled by default.
TELEGRAM_BOT_TOKEN_TRADE_COMPANION_AI_EN=
TELEGRAM_BOT_TOKEN_QUANTPILOT_AI_EN=
TELEGRAM_BOT_TOKEN_AI_STOCK_ANALYZE_EN=
TELEGRAM_BOT_TOKEN_TRADE_COMPANION_ZH=
TELEGRAM_BOT_TOKEN_STOCK_ANALYSIS_ZH=
TELEGRAM_BOT_ENABLED_TRADE_COMPANION_AI_EN=false
TELEGRAM_BOT_ENABLED_QUANTPILOT_AI_EN=false
TELEGRAM_BOT_ENABLED_AI_STOCK_ANALYZE_EN=false
TELEGRAM_BOT_ENABLED_TRADE_COMPANION_ZH=false
TELEGRAM_BOT_ENABLED_STOCK_ANALYSIS_ZH=false
# Display and paper/backtest defaults
DEFAULT_TIMEZONE=America/New_York
DISPLAY_TIMEZONE=Asia/Shanghai
DEFAULT_SLIPPAGE_BPS=8
DEFAULT_PORTFOLIO_CASH=100000
