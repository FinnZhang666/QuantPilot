{
  "schema_version": 2,
  "production_alias": "trade_companion_ai",
  "bots": [
    {
      "alias": "trade_companion_ai",
      "language": "multi",
      "name": "Trade Companion",
      "about": "AI 交易分析与陪伴 / AI trade analysis companion",
      "description": "Trade Companion 持续分析市场、记录策略表现并复盘模拟交易。It supports better decisions without replacing your judgment.",
      "token_setting": "telegram_bot_token_trade_companion_ai",
      "fallback_token_settings": ["telegram_bot_token_trade_companion_ai_en"],
      "runtime_enabled": true,
      "welcome_template": "Trade Companion — 中文 / English",
