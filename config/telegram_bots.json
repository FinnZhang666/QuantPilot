        {"command": "portfolio", "description": "我的投资 / My investments"},
        {"command": "market", "description": "市场快照 / Market snapshot"},
        {"command": "watchlist", "description": "我的关注 / Watchlist"},
        {"command": "history", "description": "历史记录 / History"},
        {"command": "review", "description": "交易复盘 / Trade reviews"},
        {"command": "holding", "description": "当前持仓 / Holdings"},
        {"command": "feedback", "description": "提交建议 / Feedback"},
        {"command": "language", "description": "切换语言 / Change language"},
        {"command": "help", "description": "使用帮助 / Help"}
      ],
      "menu": [
        {"label": "📈 AI Analysis", "action": "analyze"},
        {"label": "💼 My Investments", "action": "portfolio"},
        {"label": "🌍 Market Snapshot", "action": "market"},
        {"label": "💡 More", "action": "more"}
      ]
    },
    {
      "alias": "quantpilot_ai",
